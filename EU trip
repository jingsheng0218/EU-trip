          { date: "11/06", day: "Fri", country: "🇵🇹 Portugal", city: "Lisbon / 里斯本", accommodation: "The Central House", highlights: [{ zh: "乘坐航班直飞葡萄牙里斯本，抵达后办理入住。", en: "Direct flight to Lisbon, Portugal; check in upon arrival." }, { zh: "下午前往阿尔法玛老城游览，并参观圣若热城堡。", en: "Afternoon tour of the Alfama district and São Jorge Castle." }], transport: "TAP Air Portugal (12:35 BCN → 13:35 LIS)" },
          { date: "11/07", day: "Sat", country: "🇵🇹 Portugal", city: "Lisbon / 里斯本", accommodation: "The Central House", highlights: [{ zh: "里斯本近郊环线：探秘辛特拉的童话宫殿 (如佩纳宫)。", en: "Suburban loop: Explore the fairytale palaces of Sintra (e.g., Pena Palace)." }, { zh: "前往罗卡角，感受大西洋最西端悬崖的壮阔风光。", en: "Visit Cabo da Roca to experience the westernmost cliffs of continental Europe." }], transport: "Train • Local Bus" },
          { date: "11/08", day: "Sun", country: "🇵🇹 Portugal", city: "Lisbon / 里斯本", accommodation: "The Central House", highlights: [{ zh: "贝伦区游览：参观贝伦塔与宏伟的热罗尼莫斯修道院。", en: "Belém tour: Visit Belém Tower and the magnificent Jerónimos Monastery." }, { zh: "品尝正宗的百年葡式蛋挞 (Pastéis de Belém)。", en: "Taste the authentic, century-old pastéis de nata at Pastéis de Belém." }], transport: "Tram 15E" },
          { date: "11/09", day: "Mon", country: "🇵🇹 Portugal", city: "Lisbon / 里斯本", accommodation: "The Central House", highlights: [{ zh: "行程最后的自由时光：在老城区闲逛，采购纪念品与伴手礼。", en: "Final free day: Stroll through the old town and shop for souvenirs." }, { zh: "享用葡萄牙特色烤肉大餐，为欧洲之旅饯行。", en: "Enjoy a traditional Portuguese dinner to celebrate the trip's conclusion." }], transport: "City Walk" },
          { date: "11/10", day: "Tue", country: "🇲🇾 Return", city: "Flight / 国际航班", accommodation: "On Board", highlights: [{ zh: "清晨退房前往里斯本机场，乘国际航班回国。", en: "Early morning check-out, transfer to Lisbon Airport for the international flight home." }], transport: "International Flight (via Doha)" },
          { date: "11/11", day: "Wed", country: "🇲🇾 Return", city: "Home / 抵达", accommodation: "Home", highlights: [{ zh: "下午抵达吉隆坡，34天欧洲之旅圆满结束，准备回归接下来的学业安排。", en: "Arrive in Kuala Lumpur in the afternoon. The 34-day journey concludes, ready for the upcoming academic semester." }], transport: "Ground Transport" }
        ];

        // 填充下拉菜单
        const countrySet = new Set(rawData.map(item => item.country));
        const select = document.getElementById('country-filter');
        select.innerHTML = `<option value="All">显示全部行程 (View All)</option>` + 
            Array.from(countrySet).map(c => `<option value="${c}">${c}</option>`).join('');

        // 渲染卡片
        function renderCards(filter) {
            const container = document.getElementById('itinerary-container');
            container.innerHTML = '';
            
            const filteredData = filter === 'All' ? rawData : rawData.filter(item => item.country === filter);

            filteredData.forEach((row, index) => {
                const isWeekend = row.day === "Sat" || row.day === "Sun";
                
                // 色彩逻辑：周末采用高饱和度的日落橙/玫瑰色，平日采用优雅的靛蓝/海蓝色
                const gradientText = isWeekend ? 'from-rose-500 to-orange-500' : 'from-indigo-600 to-blue-500';
                const badgeBg = isWeekend ? 'bg-rose-50 text-rose-600 border-rose-100' : 'bg-indigo-50 text-indigo-600 border-indigo-100';
                const glowColor = isWeekend ? 'bg-rose-400' : 'bg-indigo-400';
                
                // 渲染 Highlights 为自带项目符号的极简列表
                const highlightsHtml = row.highlights.map(h => `
                    <div class="flex items-start gap-3 mb-4 last:mb-0">
                        <div class="mt-1.5 w-1.5 h-1.5 rounded-full ${isWeekend ? 'bg-rose-400' : 'bg-indigo-400'} shrink-0 opacity-80"></div>
                        <div>
                            <p class="text-[14px] font-semibold text-slate-800 leading-snug mb-0.5">${h.zh}</p>
                            <p class="text-[12px] text-slate-400 font-medium leading-snug">${h.en}</p>
                        </div>
                    </div>
                `).join('');

                const cardHtml = `
                    <div class="animate-card flex flex-col bg-white/80 backdrop-blur-xl rounded-[24px] p-7 shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-white hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden group" style="animation-delay: ${index * 0.03}s">
                        
                        <!-- 隐藏的角落氛围光晕 (Hover 显示) -->
                        <div class="absolute -right-8 -top-8 w-32 h-32 ${glowColor} rounded-full blur-[50px] opacity-0 group-hover:opacity-15 transition-opacity duration-500 pointer-events-none"></div>
                        
                        <!-- 卡片头部: 日期与国家 -->
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <div class="flex items-center gap-2 mb-1.5">
                                    <span class="text-4xl font-black bg-clip-text text-transparent bg-gradient-to-r ${gradientText}">
                                        ${row.date}
                                    </span>
                                    <span class="px-2 py-1 ${badgeBg} border text-[11px] font-bold rounded-lg uppercase tracking-widest">
                                        ${row.day}
                                    </span>
                                </div>
                                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100/80 text-slate-600 text-xs font-semibold tracking-wide">
                                    <i data-lucide="map-pin" class="w-3 h-3 text-slate-400"></i> ${row.country.split(' ')[0]} ${row.city.split(' / ')[0]}
                                </div>
                            </div>
                        </div>

                        <!-- 亮点内容区 (自动扩充高度以填满 flex) -->
                        <div class="flex-1 mb-6">
                            ${highlightsHtml}
                        </div>

                        <!-- 卡片底部: 住宿与交通 -->
                        <div class="pt-5 border-t border-slate-100/80 flex flex-col gap-3 mt-auto">
                            <div class="flex items-center gap-3 text-sm text-slate-700 group/item">
                                <div class="p-2 rounded-xl bg-emerald-50 text-emerald-600 group-hover/item:bg-emerald-100 transition-colors">
                                    <i data-lucide="bed-double" class="w-4 h-4"></i>
                                </div>
                                <span class="font-bold text-[13px]">${row.accommodation}</span>
                            </div>
                            <div class="flex items-center gap-3 text-sm text-slate-700 group/item">
                                <div class="p-2 rounded-xl bg-blue-50 text-blue-600 group-hover/item:bg-blue-100 transition-colors">
                                    <i data-lucide="navigation" class="w-4 h-4"></i>
                                </div>
                                <span class="font-semibold text-[13px] text-slate-600 line-clamp-1">${row.transport}</span>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', cardHtml);
            });

            // 重绘图标
            lucide.createIcons();
        }

        renderCards('All');

        select.addEventListener('change', (e) => {
            renderCards(e.target.value);
        });
    </script>
</body>
</html>
